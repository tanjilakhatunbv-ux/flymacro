# ──────────────── 数据库（Neon PostgreSQL） ────────────────
# 在 https://neon.tech 创建项目后获取连接串
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# ──────────────── Payload ────────────────
# 32+ 字符随机串，用于 JWT 签名
# 生成命令: openssl rand -base64 48
PAYLOAD_SECRET=

# 站点公开地址
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ──────────────── Cloudflare R2 文件存储 ────────────────
# 从 Cloudflare Dashboard > R2 > Manage API Tokens 获取
S3_BUCKET=flymacro-media
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 公开访问域名（可选，绑定自定义域名后填写）
S3_PUBLIC_URL=https://media.flymacro.qzz.io

# ──────────────── 邮件（Resend，仅用于注册验证和忘密码） ────────────────
# 在 https://resend.com 创建账号后获取 API key
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@flymacro.qzz.io
RESEND_FROM_NAME=FlyMacro

# ──────────────── 防机器人（Cloudflare Turnstile） ────────────────
# 在 Cloudflare Dashboard > Turnstile 创建站点
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ──────────────── 支付（DodoPayments） ────────────────
# 在 https://dodopayments.com 完成 KYC 后获取（支持中国身份）
# 注意：DodoPayments 仅用于积分充值，不再直接售卖宏
# 需要在 DodoPayments 后台创建 4 个 Product（对应 4 个充值档次）
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# 工作模式：test_mode（测试）或 live_mode（生产）
DODO_MODE=test_mode

# ──────────────── Cron 自动续费 ────────────────
# 部署后配置 Vercel Cron 或外部调度器每日调用 /api/cron/auto-renew?secret=xxx
CRON_SECRET=

# ──────────────── 频率限制（Upstash Redis，推荐） ────────────────
# 在 https://upstash.com 创建 Redis 数据库后获取
# 未配置时自动降级为内存频率限制（Vercel serverless 下效果有限）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────── OAuth（可选） ────────────────
# 在 https://console.cloud.google.com 创建 OAuth 2.0 客户端
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 在 https://github.com/settings/developers 创建 OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ──────────────── 客服联系方式（站内显示） ────────────────
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/flymacro
NEXT_PUBLIC_WECHAT_QR_URL=/images/wechat-qr.png
