{
  "name": "flymacro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/auto-migrate.js && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:types": "node --env-file=.env node_modules/payload/bin.js generate:types",
    "generate:importmap": "node --env-file=.env node_modules/payload/bin.js generate:importmap",
    "payload": "node --env-file=.env node_modules/payload/bin.js",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:demos": "tsx --env-file=.env src/scripts/seed-demos.ts",
    "seed:full": "tsx --env-file=.env src/scripts/seed-full-demos.ts",
    "migrate:content": "tsx --env-file=.env src/scripts/migrate-content.ts",
    "seed:news": "tsx --env-file=.env src/scripts/seed-news.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/email-resend": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-s3": "^3.0.0",
    "@payloadcms/translations": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "next": "~15.4.11",
    "next-intl": "^3.26.0",
    "payload": "^3.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "^18.20.0 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
